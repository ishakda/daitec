# Admin/privileged connection (auth + provisioning; bypasses RLS — never expose)
DATABASE_URL_ADMIN=postgresql://postgres@localhost/sahla?host=/tmp
# Application connection (RLS enforced — all business queries)
DATABASE_URL_APP=postgresql://sahla_app:sahla_app_local_dev@localhost/sahla?host=/tmp
# Session signing secret — generate with: openssl rand -hex 32
AUTH_SECRET=change-me
